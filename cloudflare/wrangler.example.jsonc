{
  "name": "npp-contact",
  "main": "contact-worker.mjs",
  "compatibility_date": "2026-10-11",
  "account_id": "821ab621fcfca78218b3b9456fcb08cb",
  "workers_dev": false,
  "routes": [{"pattern": "nubeparapymes.online/api/contact*", "zone_name": "nubeparapymes.online"}],
  "vars": {"CONTACT_TO": "nubepymesai@gmail.com", "TURNSTILE_SITE_KEY": "CONFIGURE_PUBLIC_SITE_KEY"},
  "send_email": [{"name": "EMAIL", "destination_address": "nubepymesai@gmail.com"}],
  "unsafe": {"bindings": [{"name": "CONTACT_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}]}
}
